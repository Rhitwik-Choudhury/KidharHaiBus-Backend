PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/trackefy?replicaSet=rs0
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
FIREBASE_SERVICE_ACCOUNT=REPLACE_WITH_SERVICE_ACCOUNT_JSON
GOOGLE_PLACES_API_KEY=REPLACE_WITH_BACKEND_PLACES_KEY
GOOGLE_ROUTES_API_KEY=REPLACE_WITH_BACKEND_ROUTES_KEY
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ROUTE_REFRESH_SECONDS=150
STOP_DWELL_SECONDS=20
# Keep true during rollout; old apps receive live tracking without personal route ETA.
ALLOW_LEGACY_TRIPS=true
